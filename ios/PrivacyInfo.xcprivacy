<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest of the iPhone app and of the Apple Watch app; ios/ipa.py
  puts it into both bundles. App Store Connect refuses an upload that calls a
  required-reason API without saying why (ITMS-91053).

  The entries come from the linked binaries:

      nm -u CranposeShowcase.app/CranposeShowcase \
        | grep -E '_(f?stat|lstat|fstatat|f?statv?fs|statfs|mach_absolute_time|getattrlist.*)$'
      strings CranposeShowcase.app/Watch/CranposeWatch.app/CranposeWatch \
        | grep -E 'systemUptime|UserDefaults'

  Run them again after a Cranpose update or a new dependency, and add what
  your own code collects or tracks.
-->
<plist version="1.0">
<dict>
	<!-- No tracking, no account, no analytics. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- stat, fstat, lstat, fstatat: files in the app's own folders. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- statvfs, fstatfs, fstatvfs: room on the disk before writing a
			     file. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<!-- mach_absolute_time, ProcessInfo.systemUptime and Rust's
			     std::time::Instant: the time between frames and inputs inside
			     the app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
